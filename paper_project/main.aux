\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparison of the conventional random split and the leakage-controlled run-level protocol for all three detectors. The paired bars show whether performance measured on mixed-run test data is retained when the model is evaluated on a complete unseen run. The difference between the two bars is the paper's central measurement because it separates apparent benchmark performance from run-level transfer.}}{3}{}\protected@file@percent }
\newlabel{fig:naive_vs_leakage}{{1}{3}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Pooled ROC curves under run-level holdout. Each curve concatenates out-of-fold predictions from runs that were absent during training. XGBoost has the strongest controlled discrimination, while the CNN's curve shows why its high F1 must be interpreted cautiously.}}{4}{}\protected@file@percent }
\newlabel{fig:roc_leakage}{{2}{4}{}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}The Evaluation Gap Quantifies Benchmark Optimism}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces F1 under each protocol and the resulting evaluation gap. A positive gap indicates that the conventional random split reports higher performance than the run-level protocol.}}{4}{}\protected@file@percent }
\newlabel{tab:delta}{{V}{4}{}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-fold F1 across the fifteen held-out runs. Each value corresponds to a model tested on one complete run that was absent from training. Wide dispersion indicates that detection difficulty varies across collections and that a single random split may conceal this variation.}}{4}{}\protected@file@percent }
\newlabel{fig:fold_variance}{{3}{4}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pooled run-level confusion matrix for the best controlled-F1 model. The large number of false positives explains why F1 alone overstates the CNN's usefulness for operational review.}}{4}{}\protected@file@percent }
\newlabel{fig:confusion}{{4}{4}{}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Physically Meaningful Signals Support Operator Review}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Top features identified through held-out permutation importance and tree-model SHAP analysis. Features are labeled using their physical PMU or relay meaning rather than anonymous column indices. Agreement around voltage, current, and impedance quantities suggests that the tree models rely on interpretable grid measurements, although attribution does not establish causality.}}{5}{}\protected@file@percent }
\newlabel{fig:importance}{{5}{5}{}{figure.5}{}}
