\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}Run-Level Holdout Tests Transfer to Unseen Collections}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Detection performance under leakage-controlled evaluation, reported as mean $\pm $ standard deviation across fifteen held-out runs.}}{3}{}\protected@file@percent }
